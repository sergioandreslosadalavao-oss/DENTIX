Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|database|routes|manuales|Extras)(/|$) - [F,L]
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?ruta=$1 [QSA,L]
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)|README\.md|\.md$)">
    Require all denied
</FilesMatch>

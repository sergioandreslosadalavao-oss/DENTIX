-- =====================================================================
-- 8. CONSULTAS DE EJEMPLO (DML)
-- =====================================================================

-- 8.1 Agenda del día
SELECT hora, paciente, servicio, odontologo, estado
FROM v_agenda_dia
WHERE fecha = CURRENT_DATE + 1
ORDER BY hora;

-- 8.2 Agenda del día filtrada por odontólogo
SELECT hora, paciente, servicio, estado
FROM v_agenda_dia
WHERE fecha = CURRENT_DATE + 1
  AND odontologo_id = 1
ORDER BY hora;

-- 8.3 Ficha del paciente
SELECT fecha, hora, servicio, odontologo, estado, procedimiento, nota_clinica
FROM v_historial_paciente
WHERE paciente_id = 1
ORDER BY fecha DESC, hora DESC;

-- 8.4 Buscar paciente por nombre o teléfono
SELECT id, nombre, telefono, email
FROM paciente
WHERE lower(nombre) LIKE lower('%laura%')
   OR telefono LIKE '%3001%';

-- 8.5 Cita completa con todas las tablas unidas
SELECT 
    c.id, c.fecha, c.hora, c.estado,
    p.nombre AS paciente,
    o.nombre AS odontologo,
    s.nombre AS servicio,
    s.precio,
    d.procedimiento,
    d.nota_clinica
FROM cita c
INNER JOIN paciente   p ON p.id = c.paciente_id
INNER JOIN odontologo o ON o.id = c.odontologo_id
INNER JOIN servicio   s ON s.id = c.servicio_id
LEFT JOIN detalle_cita d ON d.cita_id = c.id
ORDER BY c.fecha, c.hora;

-- 8.6 Horas libres de un odontólogo en una fecha
SELECT h.hora_libre
FROM generate_series(
        TIMESTAMP '2000-01-01 08:00',
        TIMESTAMP '2000-01-01 19:30',
        INTERVAL '30 minutes'
     ) AS g(t)
CROSS JOIN LATERAL (
    SELECT g.t::time AS hora_libre
) h
LEFT JOIN cita c
      ON c.hora = h.hora_libre
      AND c.fecha = CURRENT_DATE + 1
      AND c.odontologo_id = 1
      AND c.estado NOT IN ('cancelada', 'no_show')
WHERE c.id IS NULL
ORDER BY h.hora_libre;

-- 8.7 Agenda pública por QR: datos del odontólogo
SELECT o.nombre, o.especialidad, s.nombre AS servicio, s.duracion_min
FROM odontologo o
CROSS JOIN servicio s
WHERE o.slug_publico = 'dra-ana-torres'
ORDER BY s.nombre;

-- 8.8 Citas por odontólogo (cuántas y de qué estado)
SELECT o.nombre, c.estado, COUNT(c.id) AS total
FROM odontologo o
LEFT JOIN cita c ON c.odontologo_id = o.id
GROUP BY o.nombre, c.estado
ORDER BY o.nombre, c.estado;

-- 8.9 Servicios más solicitados
SELECT s.nombre, COUNT(c.id) AS veces
FROM servicio s
LEFT JOIN cita c ON c.servicio_id = s.id
GROUP BY s.nombre
ORDER BY veces DESC;

-- 8.10 Pacientes sin ninguna cita
SELECT p.id, p.nombre
FROM paciente p
LEFT JOIN cita c ON c.paciente_id = p.id
WHERE c.id IS NULL;